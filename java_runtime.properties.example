# Shared Java runtime configuration for the experiments project.
# Copy this file to `java_runtime.properties` and adjust it only if needed.
#
# `project_root` should point to the Java simulator project root.
# It may be:
# - a path relative to the `experiments/` directory, or
# - an absolute path.
#
# If `experiments/` is located directly under the simulator root,
# `project_root=..` is usually correct.

project_root=..
java_bin=java
java_heap=-Xmx1000m
classes_dir_rel=classes
lib_glob_rel=lib/*
main_class=net.gripps.cloud.nfv.main.NFVSchedulingTest
